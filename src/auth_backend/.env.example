# PostgreSQL Database Configuration
# IMPORTANT: Replace these values with strong, unique credentials in production
POSTGRES_USER=shelfie_user
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=auth_db

# Application Database URL (will be overridden in Docker)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT Configuration
# IMPORTANT: Generate a strong secret key for production
# You can use: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Server Configuration
HOST=0.0.0.0
PORT=8080


# PgAdmin Configuration
# IMPORTANT: Change these in production
PGADMIN_EMAIL=change_this@your-domain.com
PGADMIN_PASSWORD=change_this_to_a_strong_password

# Security Notes:
# 1. Never commit the actual .env file to version control
# 2. Use different credentials for development and production
# 3. Regularly rotate passwords and JWT secrets
# 4. In production, use a secret management service if possible
# 5. Ensure all passwords are strong (min 16 chars, mixed case, numbers, symbols)
